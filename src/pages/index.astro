---
import { getCollection } from "astro:content";
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";

const articles = await getCollection("articles");
---

<html lang="sv">
 <head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />

  <title>Köpklart – Köpguider och produktjämförelser</title>

  <meta
    name="description"
    content="Köpklart hjälper dig jämföra produkter, förstå viktiga funktioner och hitta rätt köp utifrån dina behov och din budget."
  />
</head>

  <body>
    <Navbar />

    <main class="category-page">

     <section class="category-hero">
  <p class="eyebrow">Köpklart · Köpguider och jämförelser</p>

  <h1>Hitta rätt produkt för dig</h1>

  <p>
    Vi jämför produkter, går igenom viktiga funktioner och hjälper
    dig att hitta rätt köp utifrån dina behov och din budget.
  </p>
</section>

      <section class="category-content">

        <div class="category-heading">
          <p class="eyebrow">Våra guider</p>
          <h2>Robotdammsugare värda att kolla in</h2>
        </div>

        <div class="category-articles">
          {
            articles.map((article) => (
              <a
                class="category-article"
                href={`/robotdammsugare/${article.id}`}
              >
                <div>
                  <p class="article-category">
                    {article.data.category}
                  </p>

                  <h3>{article.data.title}</h3>

                  <p class="article-summary">
                    {article.data.description}
                  </p>
                </div>

                <span class="article-link">
                  Läs guiden →
                </span>
              </a>
            ))
          }
        </div>

      </section>

    </main>
  </body>
</html>