---
import { getCollection } from "astro:content";
import "../styles/global.css";

const articles = await getCollection("articles");
---

<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>Robotdammsugare 2026 | Köpklart</title>

    <meta
      name="description"
      content="Våra guider och jämförelser hjälper dig hitta rätt robotdammsugare."
    />
  </head>

  <body>
    <header class="site-header">
      <a href="/" class="logo">Köpklart</a>

      <nav>
        <a href="/">Hem</a>
        <a href="/robotdammsugare">Robotdammsugare</a>
      </nav>
    </header>

    <main class="category-page">

      <section class="category-hero">
        <p class="eyebrow">Köpklart · Robotdammsugare</p>

        <h1>Robotdammsugare</h1>

        <p>
          Vi jämför robotdammsugare och hjälper dig hitta en modell
          som passar ditt hem, dina behov och din budget.
        </p>
      </section>

      <section class="category-content">

        <div class="category-heading">
          <p class="eyebrow">Våra guider</p>
          <h2>Robotdammsugare värda att kolla in</h2>
        </div>

        <div class="category-articles">
          {
            articles.map((article) => (
              <a
                class="category-article"
                href={`/robotdammsugare/${article.id}`}
              >
                <div>
                  <p class="article-category">
                    {article.data.category}
                  </p>

                  <h3>{article.data.title}</h3>

                  <p class="article-summary">
                    {article.data.description}
                  </p>
                </div>

                <span class="article-link">
                  Läs guiden →
                </span>
              </a>
            ))
          }
        </div>

      </section>

    </main>
  </body>
</html>