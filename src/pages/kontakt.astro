---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
---

<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>Kontakta oss | Köpklart</title>

    <meta
      name="description"
      content="Kontakta Köpklart med frågor, synpunkter eller förslag på produkter och köpguider."
    />
  </head>

  <body>
    <Navbar />

    <main class="category-page">
      <section class="category-hero">
        <p class="eyebrow">Köpklart · Kontakt</p>

        <h1>Kontakta oss</h1>

        <p>
          Har du frågor, synpunkter eller förslag på produkter
          som vi borde skriva om? Vi hör gärna från dig.
        </p>
      </section>

      <section class="category-content">
        <div class="article-content">
          <h2>Mejla oss</h2>

          <p>
            Du är välkommen att kontakta oss via e-post.
            Vi försöker svara så snart vi har möjlighet.
          </p>

          <p>
            <a href="mailto:kopklartinfo@gmail.com">
              kopklartinfo@gmail.com
            </a>
          </p>
        </div>
      </section>
    </main>
  </body>
</html>