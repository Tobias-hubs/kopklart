---
import { getCollection, render } from "astro:content";
import "../../styles/global.css";

export async function getStaticPaths() {
  const articles = await getCollection("articles");

  return articles.map((article) => ({
    params: {
      slug: article.id,
    },
    props: {    
      article,
    },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
---

<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{article.data.title} | Köpklart</title>

    <meta
      name="description"
      content={article.data.description}
    />
    <script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": article.data.title,
  "description": article.data.description,
  "datePublished": article.data.pubDate.toISOString(),
  "dateModified": article.data.pubDate.toISOString(),
  "author": {
    "@type": "Organization",
    "name": "Köpklart"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Köpklart"
  }
})} />

   <link
  rel="canonical"
  href={`https://xn--kpklart-90a.se/robotdammsugare/${article.id}/`}
/>

<meta property="og:title" content={article.data.title} />
<meta
  property="og:description"
  content={article.data.description}
/>
<meta property="og:type" content="article" />
<meta
  property="og:url"
  content={`https://xn--kpklart-90a.se/robotdammsugare/${article.id}/`}
/>
  </head>

  <body>
    <header class="site-header">
      <a href="/" class="logo">Köpklart</a>

      <nav>
        <a href="/">Hem</a>
        <a href="/robotdammsugare">Robotdammsugare</a>
        <a href="/guider">Guider</a>
      </nav>
    </header>

    <main class="article-page">
      <article class="article">
        <header class="article-header">
          <p class="eyebrow">
            {article.data.category}
          </p>

          <h1>{article.data.title}</h1>

          <p class="article-description">
            {article.data.description}
          </p>

          <p class="article-date">
            Uppdaterad {article.data.pubDate.toLocaleDateString("sv-SE")}
          </p>
        </header>

        <div class="article-content">
          <Content />
        </div>
      </article>
    </main>
  </body>
</html>