---
import { getEntry } from "astro:content";
import "../../styles/global.css";

const article = await getEntry(
  "articles",
  "basta-robotdammsugare-2026"
);
---

<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{article?.data.title ?? "Artikel"} | Köpklart</title>

    <meta
      name="description"
      content={article?.data.description ?? ""}
    />
  </head>

  <body>
    <header>
      <a href="/" class="logo">Köpklart</a>

      <nav>
        <a href="/">Hem</a>
        <a href="/robotdammsugare">Robotdammsugare</a>
        <a href="/guider">Guider</a>
      </nav>
    </header>

    <main>
      {
        article ? (
          <article class="article">
            <p class="eyebrow">{article.data.category}</p>

            <h1>{article.data.title}</h1>

            <p class="article-description">
              {article.data.description}
            </p>

            <p>Artikeln hittades!</p>
          </article>
        ) : (
          <h1>Artikeln hittades inte</h1>
        )
      }
    </main>
  </body>
</html>