---
import { getCollection } from "astro:content";
import "./../styles/global.css";

const articles = await getCollection("articles");
---

<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>Robotdammsugare 2026 | Köpklart</title>

    <meta
      name="description"
      content="Guider och jämförelser av robotdammsugare."
    />
  </head>

  <body>
    <header>
      <a href="/" class="logo">Köpklart</a>

      <nav>
        <a href="/">Hem</a>
        <a href="/robotdammsugare">Robotdammsugare</a>
        <a href="/guider">Guider</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <p class="eyebrow">Köpklart</p>

        <h1>Robotdammsugare</h1>

        <p>
          Våra guider och jämförelser hjälper dig att hitta
          rätt robotdammsugare.
        </p>
      </section>

      <section>
        <h2>Senaste guiderna</h2>

        <div class="article-list">
          {
            articles.map((article) => (
              <article class="article-card">
                <p class="eyebrow">{article.data.category}</p>

                <h3>{article.data.title}</h3>

                <p>{article.data.description}</p>

                <a href={`/robotdammsugare/${article.id}`}>
                  Läs guiden →
                </a>
              </article>
            ))
          }
        </div>
      </section>
    </main>
  </body>
</html>