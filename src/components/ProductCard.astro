
---
interface Props {
  name: string;
  description: string;
  price: string;
  badge?: string;
  rating?: number;
  pros?: string[];
  cons?: string[];
  image?: string;
  link?: string;
  retailer?: string;
}

const {
  name,
  description,
  price,
  badge,
  rating,
  pros = [],
  cons = [],
  image,
  link,
  retailer,
} = Astro.props;

const hasProductLink =
  typeof link === "string" &&
  link.trim() !== "" &&
  link !== "#";
---

<article class="product-card">
  <div class="product-image">
    {image ? (
      <img
        src={image}
        alt={name}
        loading="lazy"
        decoding="async"
        width="460"
        height="460"
      />
    ) : (
      <div class="product-image-placeholder">
        Produktbild
      </div>
    )}
  </div>

  <div class="product-content">
    <div class="product-top">
      {badge && (
        <span class="product-badge">
          {badge}
        </span>
      )}

      <h3>{name}</h3>

      {rating !== undefined && (
        <div class="product-rating">
          <span class="stars" aria-hidden="true">
            ★★★★★
          </span>
          <strong>{rating.toFixed(1)}</strong>
          <span class="rating-max">/5</span>
        </div>
      )}
    </div>

    <p class="product-description">
      {description}
    </p>

    {(pros.length > 0 || cons.length > 0) && (
      <div class="product-features">
        {pros.length > 0 && (
          <div class="product-pros">
            <strong>Fördelar</strong>
            <ul>
              {pros.map((pro) => (
                <li>✓ {pro}</li>
              ))}
            </ul>
          </div>
        )}

        {cons.length > 0 && (
          <div class="product-cons">
            <strong>Nackdelar</strong>
            <ul>
              {cons.map((con) => (
                <li>– {con}</li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )}

    <div class="product-bottom">
      <div class="product-price-container">
        <small>
          {retailer ? `Pris hos ${retailer}` : "Pris"}
        </small>

        <strong class="product-price">
          {price}
        </strong>
      </div>

      {hasProductLink && (
        <a
          href={link}
          class="product-button"
          rel="sponsored noopener"
          target="_blank"
        >
          Se pris →
        </a>
      )}
    </div>
  </div>
</article>
