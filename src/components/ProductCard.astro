---
interface Props {
  name: string;
  description: string;
  price: string;
  badge?: string;
}

const { name, description, price, badge } = Astro.props;
---

<article class="product-card">
  {badge && <span class="product-badge">{badge}</span>}

  <div class="product-image">
    <span>Produktbild</span>
  </div>

  <div class="product-content">
    <h3>{name}</h3>

    <p>{description}</p>

    <strong>{price}</strong>

    <a href="#" class="product-button">
      Se pris →
    </a>
  </div>
</article>