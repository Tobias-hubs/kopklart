---
interface Props {
  name: string;
  description: string;
  price: string;
  badge?: string;
  rating?: number;
  pros?: string[];
  cons?: string[];
  image?: string;
  link?: string;
}

const {
  name,
  description,
  price,
  badge,
  rating,
  pros = [],
  cons = [],
  image,
  link = "#",
} = Astro.props;
---

<article class="product-card">
  <div class="product-image">
    {image ? (
      <img src={image} alt={name} />
    ) : (
      <span>Produktbild</span>
    )}
  </div>

  <div class="product-content">
    {badge && <span class="product-badge">{badge}</span>}

    <h3>{name}</h3>

    {rating && (
      <div class="product-rating">
        <span>★★★★★</span>
        <strong>{rating}/5</strong>
      </div>
    )}

    <p class="product-description">{description}</p>

    {pros.length > 0 && (
      <div class="product-pros">
        <strong>Fördelar</strong>

        <ul>
          {pros.map((pro) => <li>✓ {pro}</li>)}
        </ul>
      </div>
    )}

    {cons.length > 0 && (
      <div class="product-cons">
        <strong>Nackdelar</strong>

        <ul>
          {cons.map((con) => <li>– {con}</li>)}
        </ul>
      </div>
    )}

    <div class="product-bottom">
      <div>
        <small>Pris</small>
        <strong class="product-price">{price}</strong>
      </div>

      <a href={link} class="product-button">
        Se pris →
      </a>
    </div>
  </div>
</article>