
---
interface Product {
  name: string;
  suction: string;
  mopping: string;
  selfEmptying: string;
  navigation: string;
  price: string;
}

interface Props {
  products: Product[];
}

const { products } = Astro.props;
---

<div class="comparison-wrapper">
  <div class="comparison-table">
    <div class="comparison-row comparison-header">
      <div>Produkt</div>
      <div>Sugkraft</div>
      <div>Moppning</div>
      <div>Självtömning</div>
      <div>Navigering</div>
      <div>Pris</div>
    </div>

    {products.map((product) => (
      <div class="comparison-row">
        <div class="comparison-product">
          <strong>{product.name}</strong>
        </div>

        <div>{product.suction}</div>
        <div>{product.mopping}</div>
        <div>{product.selfEmptying}</div>
        <div>{product.navigation}</div>
        <div>
          <strong>{product.price}</strong>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .comparison-wrapper {
    width: 100%;
    overflow-x: auto;
    margin: 24px 0;
    border: 1px solid #e5e5e5;
    border-radius: 10px;
    -webkit-overflow-scrolling: touch;
  }

  .comparison-table {
    min-width: 750px;
    width: 100%;
  }

  .comparison-row {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr 1.3fr 1fr 1.2fr 1fr;
    gap: 16px;
    padding: 16px;
    border-bottom: 1px solid #e5e5e5;
    align-items: center;
  }

  .comparison-row:last-child {
    border-bottom: none;
  }

  .comparison-header {
    background: #f5f5f2;
    font-weight: 700;
  }

  .comparison-product {
    min-width: 0;
  }

  .comparison-row > div {
    overflow-wrap: anywhere;
  }

  @media (max-width: 700px) {
    .comparison-row {
      padding: 12px;
      gap: 12px;
      font-size: 14px;
    }
  }
</style>
