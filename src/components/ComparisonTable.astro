---
interface Product {
  name: string;
  suction: string;
  mopping: string;
  selfEmptying: string;
  navigation: string;
  price: string;
}

interface Props {
  products: Product[];
}

const { products } = Astro.props;
---

<div class="comparison-wrapper">
  <div class="comparison-table">
    <div class="comparison-row comparison-header">
      <div>Produkt</div>
      <div>Sugkraft</div>
      <div>Moppning</div>
      <div>Självtömning</div>
      <div>Navigering</div>
      <div>Pris</div>
    </div>

    {products.map((product) => (
      <div class="comparison-row">
        <div class="comparison-product">
          <strong>{product.name}</strong>
        </div>

        <div>{product.suction}</div>

        <div>{product.mopping}</div>

        <div>{product.selfEmptying}</div>

        <div>{product.navigation}</div>

        <div>
          <strong>{product.price}</strong>
        </div>
      </div>
    ))}
  </div>
</div>